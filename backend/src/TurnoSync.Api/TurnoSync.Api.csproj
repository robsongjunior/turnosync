<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Los comentarios XML alimentan Swagger; 1591 = miembro público sin comentario, 1573 = parámetro (CancellationToken) sin etiqueta param -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurnoSync.Application\TurnoSync.Application.csproj" />
    <!-- Referencia a Infra solo para el registro de DI en Program.cs (raíz de composición) -->
    <ProjectReference Include="..\TurnoSync.Infra\TurnoSync.Infra.csproj" />
  </ItemGroup>

</Project>
