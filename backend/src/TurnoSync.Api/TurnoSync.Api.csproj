<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- XML comments feed Swagger; 1591 = public member without a comment, 1573 = parameter (CancellationToken) without a param tag -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurnoSync.Application\TurnoSync.Application.csproj" />
    <!-- Reference to Infra only for the DI registration in Program.cs (composition root) -->
    <ProjectReference Include="..\TurnoSync.Infra\TurnoSync.Infra.csproj" />
  </ItemGroup>

</Project>
